<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <p class="text-muted mb-1">Client:
      <% if policy(@project.client).show? %>
        <%= link_to @project.client.name, client_path(@project.client), class: 'text-decoration-none' %>
      <% else %>
        <span><%= @project.client.name %></span>
      <% end %>
    </p>
    <h1 class="h3 mb-1"><%= @project.name %></h1>
    <div class="text-muted small">
      <%= @project.start_date&.strftime('%B %d, %Y') || 'Start TBD' %> -
      <%= @project.end_date&.strftime('%B %d, %Y') || 'End TBD' %>
    </div>
  </div>
  <div class="text-end">
    <div class="text-muted small">Estimated budget</div>
    <div class="h4 mb-0"><%= @project.estimated_cost.present? ? number_to_currency(@project.estimated_cost) : 'Not estimated' %></div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small">Total tasks</div>
        <div class="display-6"><%= @project_stats[:total] %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small">Completed</div>
        <div class="display-6 text-success"><%= @project_stats[:completed] %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small">In progress</div>
        <div class="display-6 text-primary"><%= @project_stats[:in_progress] %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small">Blocked & overdue</div>
        <div class="display-6 text-danger"><%= @project_stats[:blocked] + @project_stats[:overdue] %></div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <div>
        <div class="text-muted small">Overall progress</div>
        <div class="fw-semibold"><%= @project_stats[:progress] %>% complete</div>
      </div>
      <div class="flex-grow-1 ms-4">
        <div class="progress" role="progressbar" aria-valuenow="<%= @project_stats[:progress] %>" aria-valuemin="0" aria-valuemax="100" style="height: 12px;">
          <div class="progress-bar bg-success" style="width: <%= @project_stats[:progress] %>%"></div>
        </div>
      </div>
    </div>
    <div class="mt-3">
      <div class="text-muted small mb-1">Key dates</div>
      <div class="d-flex gap-4">
        <div>
          <div class="text-muted small">Start</div>
          <div class="fw-semibold"><%= @project.start_date&.strftime('%b %d, %Y') || 'TBD' %></div>
        </div>
        <div>
          <div class="text-muted small">End</div>
          <div class="fw-semibold"><%= @project.end_date&.strftime('%b %d, %Y') || 'TBD' %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-5">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Project Brief</h5>
  </div>
  <div class="card-body" style="max-height: 220px; overflow-y: auto;">
    <%= simple_format(@project.description.presence || 'No description provided yet.') %>
  </div>
</div>

<% if policy(@project).update? %>
  <div class="card border-0 shadow-sm mb-5">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Design handoff</h5>
      <span class="badge bg-secondary">Manual Figma workflow</span>
    </div>
    <div class="card-body">
      <p class="text-muted small mb-3">
        The client workflow uses manual design creation in Figma (no AI design generation in-app).
        Save the latest Figma design URL below for team reference and agent #2 sync context.
      </p>

      <%= form_with model: @project, url: project_path(@project), method: :patch, local: true, class: 'mb-0' do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-md-8">
            <label class="form-label small fw-semibold">Saved design file URL</label>
            <%= f.url_field :generated_design_url, class: 'form-control form-control-sm', placeholder: 'https://www.figma.com/design/…' %>
          </div>
          <div class="col-md-4">
            <%= f.submit 'Save design URL', class: 'btn btn-outline-primary btn-sm' %>
          </div>
        </div>
      <% end %>

      <% if @project.generated_design_url.present? %>
        <div class="mt-2">
          <%= link_to 'Open saved design →', @project.generated_design_url, target: '_blank', rel: 'noopener', class: 'small' %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if policy(@project).update? %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Delivery agents (v1)</h5>
      <span class="badge bg-secondary">Wireframe → tasks · Figma sync · Spec → dev · Docs</span>
    </div>
    <div class="card-body">
      <p class="text-muted small mb-3">
        Matches the client workflow: record payments, paste wireframe + dev spec on <%= link_to 'Edit project', edit_project_path(@project), class: 'text-decoration-none' %>,
        then run agents here. Daily progress email automatically targets admin/lead users and client admins.
        <%= link_to 'Living documentation', project_documentation_pages_path(@project), class: 'text-decoration-none' %>.
      </p>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <div class="text-muted small">Design payment (internal)</div>
          <% if @project.design_payment_received_at.present? %>
            <div class="small mb-2">Recorded <%= @project.design_payment_received_at.strftime("%b %d, %Y %H:%M") %></div>
          <% else %>
            <%= button_to 'Mark design payment received', mark_design_payment_received_project_path(@project), method: :post, class: 'btn btn-outline-success btn-sm', data: { turbo: false } %>
          <% end %>
        </div>
        <div class="col-md-6">
          <div class="text-muted small">Designer agent #2 — Figma → agenda items</div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <%= button_to 'Sync Figma frames to tasks', run_designer_agent_figma_sync_project_path(@project), method: :post, class: 'btn btn-outline-secondary btn-sm', data: { turbo: false } %>
            <% if Figma::Oauth.configured? %>
              <% if current_user.figma_oauth_connected? %>
                <span class="badge bg-success">Figma connected</span>
              <% else %>
                <%= link_to 'Connect Figma account', figma_oauth_connect_path(return_to: project_path(@project)), class: 'btn btn-outline-primary btn-sm' %>
              <% end %>
            <% else %>
              <span class="text-muted small">OAuth not configured; use <code>FIGMA_ACCESS_TOKEN</code>.</span>
            <% end %>
          </div>
        </div>
      </div>
      <%= form_with url: run_designer_agent_wireframe_project_path(@project), method: :post, local: true, class: 'mb-3' do %>
        <label class="form-label small fw-semibold">Designer agent #1 — wireframe → designer tasks</label>
        <div class="row g-2 align-items-end">
          <div class="col-md-8">
            <%= select_tag :sprint_id, options_from_collection_for_select(@sprints, :id, :detailed_label), { prompt: 'Select sprint', class: 'form-select form-select-sm' } %>
          </div>
          <div class="col-md-4">
            <%= submit_tag 'Generate designer tasks', class: 'btn btn-primary btn-sm', data: { turbo: false } %>
          </div>
        </div>
      <% end %>
      <%= form_with url: run_developer_agent_from_spec_project_path(@project), method: :post, local: true, class: 'mb-3' do %>
        <label class="form-label small fw-semibold">Developer agent #3 — dev spec MD → developer tasks</label>
        <div class="row g-2 align-items-end">
          <div class="col-md-6">
            <%= select_tag :sprint_id, options_from_collection_for_select(@sprints, :id, :detailed_label), { prompt: 'Select sprint', class: 'form-select form-select-sm' } %>
          </div>
          <div class="col-md-4">
            <div class="form-check">
              <%= check_box_tag :skip_sprint_payment, '1', false, class: 'form-check-input' %>
              <%= label_tag :skip_sprint_payment, 'Skip sprint payment gate', class: 'form-check-label small' %>
            </div>
          </div>
          <div class="col-md-2">
            <%= submit_tag 'Generate dev tasks', class: 'btn btn-dark btn-sm', data: { turbo: false } %>
          </div>
        </div>
      <% end %>
      <%= button_to 'Documentation agent #6 — refresh living doc', generate_documentation_agent_project_path(@project), method: :post, class: 'btn btn-outline-primary btn-sm', data: { turbo: false } %>
    </div>
  </div>
<% end %>

<% if policy(@project).figma_import? %>
  <div class="d-flex flex-wrap gap-2 align-items-center mb-4">
    <%= link_to 'Design → Tasks (Figma import)', figma_import_project_path(@project), class: 'btn btn-outline-primary btn-sm' %>
    <span class="text-muted small">Scan frames/components and create agenda items.</span>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="h5 mb-0">Pages</h4>
  <% if policy(Page.new(project: @project)).create? %>
    <%= link_to 'Add Page', new_project_page_path(@project), class: 'btn btn-sm btn-outline-dark' %>
  <% end %>
</div>

<% @pages = policy_scope(Page).where(project: @project).order(:title) %>
<% if @pages.any? %>
  <div class="row g-3 mb-5">
    <% @pages.each do |page| %>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title mb-2"><%= page.title %></h5>
            <div class="text-muted small mb-2">
              <%= link_to page.url, page.url, target: '_blank', class: 'text-decoration-none' %>
            </div>
            <p class="text-muted small mb-3 flex-grow-1" style="max-height: 60px; overflow: hidden;">
              <%= truncate(page.description, length: 100) if page.description.present? %>
            </p>
            <div class="mt-auto">
              <%= link_to 'View Page', project_page_path(@project, page), class: 'btn btn-outline-dark btn-sm' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info mb-5">No pages documented yet for this project.</div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="h5 mb-0">Sprints</h4>
</div>

<% if @sprint_summaries.any? %>
  <div class="row g-3">
    <% @sprint_summaries.each do |summary| %>
      <% sprint = summary[:sprint] %>
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h5 class="card-title mb-1"><%= sprint.name %></h5>
                <div class="text-muted small"><%= sprint.goal.presence || 'No goal set' %></div>
              </div>
              <span class="badge bg-light text-dark"><%= summary[:total] %> tasks</span>
            </div>
            <div class="text-muted small mb-1">Progress</div>
            <div class="progress mb-3" role="progressbar" aria-valuenow="<%= summary[:progress] %>" aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
              <div class="progress-bar" style="width: <%= summary[:progress] %>%"></div>
            </div>
            <div class="d-flex justify-content-between text-muted small mb-3">
              <span>Completed: <strong class="text-dark"><%= summary[:completed] %></strong></span>
              <span>In progress: <strong class="text-dark"><%= summary[:in_progress] %></strong></span>
              <span>Blocked: <strong class="text-dark"><%= summary[:blocked] %></strong></span>
            </div>
            <div class="mt-auto text-end">
              <%= link_to 'View sprint', sprint_path(sprint), class: 'btn btn-outline-dark btn-sm' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">No sprints defined yet for this project.</div>
<% end %>
