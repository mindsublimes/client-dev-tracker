<div class="mb-3">
  <%= link_to "← #{@project.name}", project_path(@project), class: "text-decoration-none small" %>
</div>
<h1 class="h3 mb-3">Documentation</h1>

<% if @pages.any? %>
  <ul class="list-group shadow-sm">
    <% @pages.each do |p| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= link_to p.title, project_documentation_page_path(@project, p.slug), class: "text-decoration-none fw-semibold" %>
        <% if p.generated_at.present? %>
          <span class="text-muted small">Updated <%= p.generated_at.strftime("%b %d, %Y %H:%M") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">No documentation pages yet. Run the documentation agent from the project page.</p>
<% end %>
