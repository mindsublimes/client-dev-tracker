<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-0">Invoices</h1>
    <p class="text-muted mb-0">Milestone billing and payment follow-up status</p>
  </div>
  <%= link_to 'Reports', reports_path, class: 'btn btn-sm btn-outline-secondary' %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if @invoices.any? %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Issued</th>
              <th>Client</th>
              <th>Milestone</th>
              <th>Amount</th>
              <th>Status</th>
              <th>External</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @invoices.each do |inv| %>
              <tr>
                <td><%= inv.issued_at&.strftime('%b %d, %Y') %></td>
                <td><%= inv.client&.name %></td>
                <td>
                  <%= link_to inv.agenda_item.title.truncate(50), agenda_item_path(inv.agenda_item), class: 'text-decoration-none' %>
                </td>
                <td><%= number_to_currency(inv.amount) %> <%= inv.currency %></td>
                <td>
                  <span class="badge bg-<%= inv.invoice_paid? ? 'success' : inv.invoice_void? ? 'secondary' : 'warning' %>">
                    <%= inv.status %>
                  </span>
                </td>
                <td class="small text-muted">
                  <%= inv.external_provider %>
                  <% if inv.external_id.present? %>
                    · <%= inv.external_id.truncate(20) %>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to 'View', invoice_path(inv), class: 'btn btn-sm btn-outline-dark' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-4 text-muted">No invoices yet.</div>
    <% end %>
  </div>
</div>
